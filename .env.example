# Option 1: Web3Forms (Recommended — free, 1 key, 10-second setup)
# Get your free access key by entering your email (kiranbabuv21@gmail.com) at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key

# Option 2: EmailJS (Alternative)
# Get keys from https://www.emailjs.com/
# Create a service (Gmail), template, and copy your Public Key.
# Template variables: from_name, from_email, reply_to, message, to_email
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
